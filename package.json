{
  "name": "bitcoin-prediction-game",
  "version": "1.0.0",
  "private": true,
  "description": "Predict whether BTC/USD will be higher or lower after one minute. Server-authoritative game with a Postgres-backed settlement loop.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "standalone:prepare": "node scripts/prepare-standalone.mjs",
    "start:standalone": "node .next/standalone/server.js"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.30"
    }
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "next": "^15.5.28",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.28",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
