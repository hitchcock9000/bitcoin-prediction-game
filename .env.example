# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string. Any managed Postgres works (Railway, Render,
# Neon, RDS). Local example:
#   postgresql://postgres:postgres@localhost:5432/bpg_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bpg_dev

# Secret used to sign the player identity cookie (HMAC-SHA256). Must be at
# least 32 characters. Generate one with:
#   openssl rand -base64 48
PLAYER_COOKIE_SECRET=replace-me-with-a-long-random-value-at-least-32-chars

# --- Optional ---------------------------------------------------------------

# Set to "true" when the database requires TLS (most managed providers do).
# DATABASE_SSL=false

# Secure cookies are enabled automatically when NODE_ENV=production. Override
# only if you are serving over plain HTTP (e.g. a local preview).
# COOKIE_SECURE=false

# Market data source: "coinbase" (default, real BTC/USD) or "simulated".
# "simulated" is refused in production unless ALLOW_SIMULATED_PRICES=true.
# PRICE_PROVIDER=coinbase
# ALLOW_SIMULATED_PRICES=false
# COINBASE_API_BASE=https://api.exchange.coinbase.com
# PRICE_FETCH_TIMEOUT_MS=4000

# Settlement scheduler (runs inside the web process). Disable it on every
# instance except one if you scale beyond a single container.
# SETTLEMENT_SCHEDULER_ENABLED=true
# SETTLEMENT_INTERVAL_MS=5000

# Shared secret protecting POST /api/settle, so an external cron can drive the
# settlement sweep when no long-running worker is available. Leave unset to
# disable the endpoint entirely.
# SETTLEMENT_SECRET=replace-me

# Integration tests use this database (created and migrated automatically by
# the test setup). Defaults to the local sandbox instance.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/bpg_test
